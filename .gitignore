# No trailing slash: a worktree links node_modules to the main tree rather than
# installing its own, and "node_modules/" matches only a real directory.
node_modules
dist/
.pgdata/
*.db
*.db-shm
*.db-wal
.env
# Every .env variant (.env.prod, .env.local, …) — these hold live connection
# strings. .env.example is the one committed file: placeholders only.
.env.*
!.env.example
.DS_Store
.vercel/
# Brainstorming mockups — working scratch, not product code
.superpowers/
# Real-data backups — never commit (contain live business data)
*BACKUP*.json
*-FLAGGED-*.csv
# Cleanup-script reports — customer names, product codes, real plant data
artwork-dup-report-*.csv
product-code-reassign-*.csv
series-gap-close-*.csv
board-freeze-backfill-*.txt
# Pre-change snapshots. Named SNAPSHOT rather than BACKUP, so the *BACKUP*.json
# rule above misses them — and they are the largest dump of all: whole product
# rows, customer and all.
*SNAPSHOT*.json
backups/
