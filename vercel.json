{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm run build -w client",
  "outputDirectory": "client/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "excludeFiles": "{*BACKUP*.json,*-FLAGGED-*.csv,backup-ci-prod-supabase.mjs,migrate-local-to-supabase.mjs,docs/**,server/.pgdata/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
