{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm run build -w client",
  "outputDirectory": "client/dist",
  "framework": null,
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "excludeFiles": "{backups/**,*BACKUP*.json,*-FLAGGED-*.csv,docs/**,scripts/**,supabase/**,server/.pgdata/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
