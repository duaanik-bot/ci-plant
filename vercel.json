{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && npm run build -w client",
  "outputDirectory": "client/dist",
  "framework": null,
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "skills/enquiry-desk/**",
      "excludeFiles": "{backups/**,*BACKUP*.json,*-FLAGGED-*.csv,docs/**,scripts/**,supabase/**,server/.pgdata/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/enquiry-fetch", "schedule": "30 5,9 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
