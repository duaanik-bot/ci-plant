# ci-erp environment variables — copy to .env only if you need to override a
# default. Local development normally needs NO .env file at all.
#
# .env is gitignored. Never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
# LEAVE UNSET FOR LOCAL DEVELOPMENT.
# With no DATABASE_URL the server starts an embedded PostgreSQL on port 5439 and
# persists to server/.pgdata — zero setup, and no way to touch cloud data.
#
# server/src/db.js refuses to build schema or seed against a non-localhost
# database, so pointing this at Supabase and running `npm run dev` is blocked by
# design (override: ALLOW_REMOTE_SCHEMA_SYNC=yes, for deliberate schema work).
#
# Production (set in Vercel, NOT here): the Supabase transaction-mode pooler for
# colour-impressions-prod, i.e. aws-1-ap-south-1.pooler.supabase.com.
# DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# MANDATORY in production. The server refuses to boot without it when
# NODE_ENV=production or VERCEL=1 (see server/src/auth.js). Locally, a random
# secret is generated per run, which is why local sessions end on restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=

# Password for the first seeded admin. Optional — when unset the seeder
# generates a random one and prints it once. Local development only.
# ADMIN_PASSWORD=

# ─── Tuning (optional) ───────────────────────────────────────────────────────
# pg pool size. Default 20, sized for the dashboard's ~19-query fan-out.
# PG_POOL_MAX=20

# API port for the local server. Default 4000.
# PORT=4000

# Where the Vite dev server proxies /api. Default http://localhost:4000 —
# used to point the client at a second server instance during verification.
# VITE_API_TARGET=http://localhost:4000
